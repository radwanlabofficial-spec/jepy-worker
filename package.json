{
  "name": "jepy-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply jepy-leads --local",
    "db:remote": "wrangler d1 migrations apply jepy-leads --remote",
    "seed:local": "wrangler d1 execute jepy-leads --local --file=seed.sql",
    "seed:remote": "wrangler d1 execute jepy-leads --remote --file=seed.sql"
  },
  "dependencies": {
    "hono": "4.6.14",
    "jose": "5.9.6",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20241218.0",
    "typescript": "5.7.2",
    "wrangler": "3.99.0"
  }
}
